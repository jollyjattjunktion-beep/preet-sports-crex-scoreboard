<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Preet Sports - OBS Scoreboard</title>
<style>
    * { box-sizing: border-box; }
    html, body {
        margin: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: transparent;
        font-family: Arial, Helvetica, sans-serif;
    }

    /* Transparent 1920x1080 OBS canvas */
    .stage {
        width: 1920px;
        height: 1080px;
        position: relative;
        background: transparent;
        color: white;
    }

    .scoreboard {
        position: absolute;
        left: 4.5%;
        right: 4.5%;
        top: 4%;
        height: 245px;
        filter: drop-shadow(0 8px 20px rgba(0,0,0,.35));
    }

    .main {
        height: 145px;
        display: grid;
        grid-template-columns: 1fr 390px 1fr;
        align-items: stretch;
        background:
            linear-gradient(135deg, rgba(66,7,4,.98), rgba(110,17,8,.96));
        border: 3px solid #d6b400;
        border-radius: 0 0 28px 28px;
        overflow: hidden;
    }

    .team {
        display: flex;
        align-items: center;
        gap: 25px;
        padding: 12px 30px;
    }

    .team.right {
        justify-content: flex-end;
        text-align: right;
        flex-direction: row-reverse;
    }

    .logo {
        width: 92px;
        height: 92px;
        border-radius: 50%;
        object-fit: contain;
        background: #8b8b8b;
        border: 7px solid #d6b400;
        padding: 4px;
        flex: 0 0 auto;
    }

    .team-name {
        font-size: 38px;
        font-weight: 900;
        line-height: 1;
        text-transform: uppercase;
        text-shadow: 0 3px 8px #000;
    }

    .scorebox {
        margin: 18px;
        border: 3px solid #fff0a6;
        border-radius: 32px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        background: rgba(72,8,4,.72);
    }

    .score {
        font-size: 60px;
        line-height: .95;
        font-weight: 900;
    }

    .overs {
        margin-top: 8px;
        font-size: 25px;
        font-weight: 700;
    }

    .stats {
        height: 92px;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 8px;
        margin-top: 8px;
    }

    .stat {
        border: 2px solid #fff0a6;
        border-radius: 22px;
        background:
            radial-gradient(circle at 50% 15%, rgba(255,174,0,.55), rgba(44,20,0,.95) 65%);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        font-weight: 800;
    }

    .stat-label {
        font-size: 19px;
        text-transform: uppercase;
        opacity: .88;
    }

    .stat-value {
        font-size: 31px;
    }

    .players {
        position: absolute;
        left: 4.5%;
        right: 4.5%;
        bottom: 30px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
    }

    .player-card {
        height: 105px;
        border: 2px solid #d6b400;
        border-radius: 18px;
        background:
            linear-gradient(110deg, rgba(112,0,15,.98), rgba(210,20,45,.78) 50%, rgba(75,0,10,.98));
        display: flex;
        align-items: center;
        padding: 8px 20px;
        overflow: hidden;
    }

    .player-card img {
        width: 84px;
        height: 84px;
        border-radius: 50%;
        border: 5px solid #d6b400;
        background: #999;
        object-fit: cover;
        margin-right: 17px;
    }

    .player-name {
        font-size: 23px;
        font-weight: 800;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .player-score {
        font-size: 31px;
        font-weight: 900;
        margin-top: 5px;
    }

    .status {
        position: absolute;
        right: 10px;
        top: 8px;
        font-size: 13px;
        opacity: .65;
    }

    .error {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        color: #fff;
        background: rgba(120,0,0,.85);
        padding: 14px 20px;
        border-radius: 12px;
        font-weight: 700;
        display: none;
    }
</style>
</head>
<body>
<div class="stage">

    <div class="scoreboard">
        <div class="main">
            <div class="team">
                <img id="logoA" class="logo" alt="">
                <div id="teamA" class="team-name">TEAM A</div>
            </div>

            <div class="scorebox">
                <div id="score" class="score">--/--</div>
                <div id="overs" class="overs">Overs --</div>
            </div>

            <div class="team right">
                <img id="logoB" class="logo" alt="">
                <div id="teamB" class="team-name">TEAM B</div>
            </div>
        </div>

        <div class="stats">
            <div class="stat">
                <span class="stat-label">CRR</span>
                <span id="crr" class="stat-value">--</span>
            </div>
            <div class="stat">
                <span class="stat-label">Partnership</span>
                <span id="partnership" class="stat-value">--</span>
            </div>
            <div class="stat">
                <span class="stat-label">Over</span>
                <span id="overStat" class="stat-value">--</span>
            </div>
            <div class="stat">
                <span class="stat-label">Score</span>
                <span id="scoreStat" class="stat-value">--</span>
            </div>
        </div>
    </div>

    <div id="players" class="players"></div>
    <div id="status" class="status">CREX DATA</div>
    <div id="error" class="error"></div>
</div>

<script>
const params = new URLSearchParams(location.search);
const customUrl = params.get("url");

function esc(s) {
    return String(s ?? "").replace(/[&<>"']/g, c => ({
        "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;", "'":"&#039;"
    }[c]));
}

function setImage(el, src) {
    if (src) {
        el.src = src;
        el.style.display = "block";
    } else {
        el.removeAttribute("src");
    }
}

function render(data) {
    document.getElementById("teamA").textContent = data.team_a || "TEAM A";
    document.getElementById("teamB").textContent = data.team_b || "TEAM B";
    document.getElementById("score").textContent = data.score || "--";
    document.getElementById("overs").textContent = "Overs " + (data.overs || "--");

    document.getElementById("crr").textContent = data.crr || "--";
    document.getElementById("partnership").textContent = data.partnership || "--";
    document.getElementById("overStat").textContent = data.overs || "--";
    document.getElementById("scoreStat").textContent = data.score || "--";

    setImage(document.getElementById("logoA"), data.team_a_logo);
    setImage(document.getElementById("logoB"), data.team_b_logo);

    const players = data.players || [];
    const holder = document.getElementById("players");

    holder.innerHTML = players.slice(0, 2).map(p => `
        <div class="player-card">
            ${p.image ? `<img src="${esc(p.image)}" alt="">` : `<img alt="">`}
            <div>
                <div class="player-name">${esc(p.name || "Player")}</div>
                <div class="player-score">${esc(p.score || "--")}</div>
            </div>
        </div>
    `).join("");

    // Keep a third card as a clean blank panel to match the supplied layout.
    if (players.length < 3) {
        holder.innerHTML += `<div class="player-card"></div>`;
    }

    document.getElementById("status").textContent =
        "LIVE • " + (data.cache_age_seconds ?? 0) + "s";
}

async function update() {
    try {
        const endpoint = customUrl
            ? "/api/score?url=" + encodeURIComponent(customUrl)
            : "/api/score";

        const res = await fetch(endpoint, {cache: "no-store"});
        const data = await res.json();

        if (!res.ok || !data.ok) throw new Error(data.error || "No data");
        render(data);
        document.getElementById("error").style.display = "none";
    } catch (e) {
        const box = document.getElementById("error");
        box.textContent = "Score data unavailable: " + e.message;
        box.style.display = "block";
    }
}

update();
setInterval(update, 2000);
</script>
</body>
</html>

